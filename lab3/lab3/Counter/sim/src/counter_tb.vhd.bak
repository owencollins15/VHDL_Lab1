-- seven segment test bench
-------------------------------------------------------------------------------
library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity counter_tb is
end counter_tb;

architecture arch of counter_tb is

component counter_tb is
generic(
counter_max : integer := 3
);
port (  clk     : in  std_logic;
    reset   : in  std_logic;
    sum_out : out std_logic_vector(3 downto 0)
  );
  end component;
  
  signal sum_out  : std_logic_vector(3 downto 0);
constant period : time := 20ns;
signal clk      : std_logic := '0';
signal reset    : std_logic := '1';

begin

-- clock process
clock: process
  begin
    clk <= not clk;
    wait for period/2;
end process;

-- reset process
async_reset: process
  begin
    wait for 2 * period;
    reset <= '0';
    wait;
end process;

uut: counter_top
  generic map (
    counter_max => 3
  )
  port map(
    clk     => clk,
    reset   => reset,
    sum_out => sum_out
  );

end arch;

