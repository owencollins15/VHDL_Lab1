library ieee;
use ieee.std_logic_1164.all;

entity counter_top is
  generic (
    counter_max : integer := 3
  );
  port (
    clk     : in  std_logic;
    reset   : in  std_logic;
    sum_out : out std_logic_vector(3 downto 0)
  );
end counter_top;

architecture beh of counter_top is

  component generic_adder_beh is
    generic ( bits : integer := 4 );
    port (
      a    : in  std_logic_vector(bits-1 downto 0);
      b    : in  std_logic_vector(bits-1 downto 0);
      cin  : in  std_logic;
      sum  : out std_logic_vector(bits-1 downto 0);
      cout : out std_logic
    );
  end component;

  component generic_counter is
    generic ( max_count : integer := 3 );
    port (
      clk    : in  std_logic;
      reset  : in  std_logic;
      output : out std_logic
    );
  end component;

  signal sum_sig     : std_logic_vector(3 downto 0);
  signal sum_reg_sig : std_logic_vector(3 downto 0) := (others => '0');
  signal enable      : std_logic;
  signal cout_unused : std_logic;

begin

  adder_inst: generic_adder_beh
    generic map ( bits => 4 )
    port map ( a => sum_reg_sig, b => "0001", cin => '0',
               sum => sum_sig, cout => cout_unused );

  counter_inst: generic_counter
    generic map ( max_count => counter_max )
    port map ( clk => clk, reset => reset, output => enable );

  process(clk, reset)
  begin
    if reset = '1' then
      sum_reg_sig <= (others => '0');
    elsif rising_edge(clk) then
      if enable = '1' then
        sum_reg_sig <= sum_sig;
      end if;
    end if;
  end process;

  sum_out <= sum_reg_sig;

end beh;
